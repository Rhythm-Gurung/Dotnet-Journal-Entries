@page "/settings"
@using journalstart.Components.Shared

<section class="mt-4 space-y-6">
    <h2 class="text-2xl font-semibold text-slate-800 dark:text-slate-100">Settings</h2>

    <!-- Theme Customization Section -->
    <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
        <h3 class="mb-4 text-lg font-semibold text-slate-800 dark:text-slate-100">Theme Customization</h3>
        <p class="mb-6 text-sm text-slate-600 dark:text-slate-300">Choose your preferred theme or customize your own
            colors</p>

        <!-- Theme Selector -->
        <div class="mb-6">
            <label class="mb-3 block text-sm font-medium text-slate-700 dark:text-slate-300">Theme Mode</label>
            <div class="grid grid-cols-3 gap-3">
                <!-- Light Theme -->
                <button @onclick='() => SetTheme("light")'
                    class="relative flex flex-col items-center gap-2 rounded-lg border-2 p-4 transition @GetThemeButtonClass("light")">
                    <svg class="h-8 w-8 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-200">Light</span>
                </button>

                <!-- Dark Theme -->
                <button @onclick='() => SetTheme("dark")'
                    class="relative flex flex-col items-center gap-2 rounded-lg border-2 p-4 transition @GetThemeButtonClass("dark")">
                    <svg class="h-8 w-8 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-200">Dark</span>
                </button>

                <!-- (Custom theme removed) -->
            </div>
        </div>

        <!-- Custom theme removed: customization UI and logic deleted -->

        <!-- Theme Preview -->
        <div class="mt-6">
            <label class="mb-3 block text-sm font-medium text-slate-700 dark:text-slate-300">Preview</label>
            <div
                class="space-y-3 rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900">
                <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
                    <h5 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Sample Card</h5>
                    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">This is how your journal entries will
                        look with the selected theme.</p>
                    <div class="mt-3 flex gap-2">
                        <span
                            class="rounded-full bg-indigo-100 px-3 py-1 text-xs font-medium text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">tag-example</span>
                        <span
                            class="rounded-full bg-pink-100 px-3 py-1 text-xs font-medium text-pink-800 dark:bg-pink-900 dark:text-pink-200">another-tag</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Security Section -->
    <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
        <h3 class="mb-4 text-lg font-semibold text-slate-800 dark:text-slate-100">Security</h3>
        <p class="mb-6 text-sm text-slate-600 dark:text-slate-300">Set a 4-digit PIN to lock your journal entries</p>

        @if (HasPin)
        {
            <div class="space-y-4">
                <div class="flex items-center gap-3 rounded-lg bg-green-100 p-4 dark:bg-green-900/20">
                    <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div class="flex-1">
                        <p class="text-sm font-medium text-green-800 dark:text-green-300">PIN is set</p>
                        <p class="text-xs text-green-600 dark:text-green-400">Your journal entries can be locked with a PIN
                        </p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <button @onclick="ShowChangePinModal"
                        class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600">
                        Change PIN
                    </button>
                    <button @onclick="RemovePin"
                        class="flex-1 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-600 transition hover:bg-red-50 dark:border-red-600 dark:bg-slate-700 dark:text-red-400 dark:hover:bg-red-900/20">
                        Remove PIN
                    </button>
                </div>
            </div>
        }
        else
        {
            <button @onclick="ShowSetPinModal"
                class="w-full rounded-lg bg-indigo-600 px-4 py-3 text-sm font-medium text-white transition hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600">
                <div class="flex items-center justify-center gap-2">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    Set PIN
                </div>
            </button>
        }
    </div>
</section>

<PinModal IsVisible="@ShowPinModal" Title="@PinModalTitle" IsSettingPin="true" OnSubmit="HandlePinSubmit"
    OnCancel="HandlePinCancel" />