@page "/settings"

<section class="mt-4 space-y-6">
    <h2 class="text-2xl font-semibold text-slate-800 dark:text-slate-100">Settings</h2>

    <!-- Theme Customization Section -->
    <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
        <h3 class="mb-4 text-lg font-semibold text-slate-800 dark:text-slate-100">Theme Customization</h3>
        <p class="mb-6 text-sm text-slate-600 dark:text-slate-300">Choose your preferred theme or customize your own
            colors</p>

        <!-- Theme Selector -->
        <div class="mb-6">
            <label class="mb-3 block text-sm font-medium text-slate-700 dark:text-slate-300">Theme Mode</label>
            <div class="grid grid-cols-3 gap-3">
                <!-- Light Theme -->
                <button @onclick='() => SetTheme("light")'
                    class="relative flex flex-col items-center gap-2 rounded-lg border-2 p-4 transition @GetThemeButtonClass("light")">
                    <svg class="h-8 w-8 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-200">Light</span>
                </button>

                <!-- Dark Theme -->
                <button @onclick='() => SetTheme("dark")'
                    class="relative flex flex-col items-center gap-2 rounded-lg border-2 p-4 transition @GetThemeButtonClass("dark")">
                    <svg class="h-8 w-8 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-200">Dark</span>
                </button>

                <!-- (Custom theme removed) -->
            </div>
        </div>

        <!-- Custom theme removed: customization UI and logic deleted -->

        <!-- Theme Preview -->
        <div class="mt-6">
            <label class="mb-3 block text-sm font-medium text-slate-700 dark:text-slate-300">Preview</label>
            <div
                class="space-y-3 rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900">
                <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
                    <h5 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Sample Card</h5>
                    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">This is how your journal entries will
                        look with the selected theme.</p>
                    <div class="mt-3 flex gap-2">
                        <span
                            class="rounded-full bg-indigo-100 px-3 py-1 text-xs font-medium text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">tag-example</span>
                        <span
                            class="rounded-full bg-pink-100 px-3 py-1 text-xs font-medium text-pink-800 dark:bg-pink-900 dark:text-pink-200">another-tag</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Security Section -->
    <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
        <h3 class="mb-4 text-lg font-semibold text-slate-800 dark:text-slate-100">Security</h3>
        <p class="mb-6 text-sm text-slate-600 dark:text-slate-300">Protect your journal with a 4-digit PIN</p>

        @if (!isPinSet)
        {
            <!-- Set PIN Section -->
            <div class="space-y-4">
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">Set PIN (4
                        digits)</label>
                    <input type="password" @bind="newPin" @bind:event="oninput" maxlength="4"
                        placeholder="Enter 4-digit PIN"
                        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" />
                </div>
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">Confirm PIN</label>
                    <input type="password" @bind="confirmPin" @bind:event="oninput" maxlength="4" placeholder="Re-enter PIN"
                        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" />
                </div>

                @if (!string.IsNullOrEmpty(pinError))
                {
                    <div class="rounded-lg bg-red-50 p-3 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200">
                        @pinError
                    </div>
                }

                @if (!string.IsNullOrEmpty(pinSuccess))
                {
                    <div class="rounded-lg bg-green-50 p-3 text-sm text-green-800 dark:bg-green-900/20 dark:text-green-200">
                        @pinSuccess
                    </div>
                }

                <button @onclick="SetPin"
                    class="w-full rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:bg-indigo-500 dark:hover:bg-indigo-600">
                    Set PIN Lock
                </button>
            </div>
        }
        else
        {
            <!-- PIN Already Set Section -->
            <div class="space-y-4">
                <div class="flex items-center gap-3 rounded-lg bg-green-50 p-4 dark:bg-green-900/20">
                    <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <div class="flex-1">
                        <p class="font-medium text-green-800 dark:text-green-200">PIN Lock Active</p>
                        <p class="text-sm text-green-700 dark:text-green-300">Your journal is protected with a PIN</p>
                    </div>
                </div>

                @if (isModifying)
                {
                    <!-- Modify PIN Form -->
                    <div
                        class="space-y-3 rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-900">
                        <div>
                            <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">Current PIN</label>
                            <input type="password" @bind="currentPin" @bind:event="oninput" maxlength="4"
                                placeholder="Enter current PIN"
                                class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" />
                        </div>
                        <div>
                            <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">New PIN (4
                                digits)</label>
                            <input type="password" @bind="newPin" @bind:event="oninput" maxlength="4"
                                placeholder="Enter new 4-digit PIN"
                                class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" />
                        </div>
                        <div>
                            <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">Confirm New
                                PIN</label>
                            <input type="password" @bind="confirmPin" @bind:event="oninput" maxlength="4"
                                placeholder="Re-enter new PIN"
                                class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2 text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" />
                        </div>

                        @if (!string.IsNullOrEmpty(pinError))
                        {
                            <div class="rounded-lg bg-red-50 p-3 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200">
                                @pinError
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(pinSuccess))
                        {
                            <div class="rounded-lg bg-green-50 p-3 text-sm text-green-800 dark:bg-green-900/20 dark:text-green-200">
                                @pinSuccess
                            </div>
                        }

                        <div class="flex gap-3">
                            <button @onclick="UpdatePin"
                                class="flex-1 rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-indigo-500 dark:hover:bg-indigo-600">
                                Update PIN
                            </button>
                            <button @onclick="CancelModify"
                                class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-2 font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
                else if (isDeleting)
                {
                    <!-- Delete PIN Confirmation Form -->
                    <div
                        class="space-y-3 rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-800 dark:bg-red-900/20">
                        <div class="flex items-start gap-2 text-red-800 dark:text-red-200">
                            <svg class="mt-0.5 h-5 w-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <div>
                                <p class="font-semibold">Delete PIN Lock</p>
                                <p class="mt-1 text-sm">This will remove the PIN protection from all locked journal entries.
                                    Enter your PIN to confirm.</p>
                            </div>
                        </div>

                        <div>
                            <label class="mb-2 block text-sm font-medium text-red-900 dark:text-red-200">Enter PIN to
                                Confirm</label>
                            <input type="password" @bind="deletePin" @bind:event="oninput" maxlength="4"
                                placeholder="Enter your PIN"
                                class="w-full rounded-lg border border-red-300 bg-white px-4 py-2 text-slate-900 focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500 dark:border-red-700 dark:bg-slate-700 dark:text-slate-100" />
                        </div>

                        @if (!string.IsNullOrEmpty(pinError))
                        {
                            <div class="rounded-lg bg-red-100 p-3 text-sm text-red-900 dark:bg-red-900/40 dark:text-red-200">
                                @pinError
                            </div>
                        }

                        <div class="flex gap-3">
                            <button @onclick="DeletePin"
                                class="flex-1 rounded-lg bg-red-600 px-4 py-2 font-medium text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 dark:bg-red-600 dark:hover:bg-red-700">
                                Confirm Delete
                            </button>
                            <button @onclick="CancelDelete"
                                class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-2 font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600">
                                Cancel
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Modify/Delete Buttons -->
                    <div class="flex gap-3">
                        <button @onclick="ShowModifyForm"
                            class="flex-1 rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-indigo-500 dark:hover:bg-indigo-600">
                            Modify PIN
                        </button>
                        <button @onclick="ShowDeleteForm"
                            class="flex-1 rounded-lg border border-red-300 bg-white px-4 py-2 font-medium text-red-600 transition hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 dark:border-red-700 dark:bg-slate-700 dark:text-red-400 dark:hover:bg-red-900/20">
                            Delete PIN
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</section>