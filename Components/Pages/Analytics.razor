@page "/analytics"
@using journalstart.Models

<section class="mt-4 space-y-6">
    <!-- Header with Date Range Filter -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl font-semibold text-slate-800 dark:text-slate-100">Analytics</h2>
        <div class="flex gap-1 rounded-lg bg-slate-100 p-1 dark:bg-slate-700">
            @foreach (var range in DateRanges)
            {
                <button @onclick="() => SetDateRange(range.Key)"
                    class="rounded px-3 py-1 text-sm transition @(SelectedRange == range.Key ? "bg-white shadow-sm font-medium dark:bg-slate-600 dark:text-slate-100" : "text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100")">
                    @range.Value
                </button>
            }
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        <!-- Current Streak -->
        <div
            class="rounded-lg border border-orange-200 bg-gradient-to-br from-orange-50 to-white p-4 dark:border-orange-900 dark:from-orange-900/20 dark:to-slate-800">
            <div class="mb-2 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd"
                        d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z"
                        clip-rule="evenodd" />
                </svg>
                Current Streak
            </div>
            <div class="text-3xl font-bold text-slate-900 dark:text-slate-100">@Stats.CurrentStreak</div>
            <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                @(Stats.CurrentStreak > 0 ? "Keep it up! 🔥" : "Start writing today!")
            </div>
        </div>

        <!-- Longest Streak -->
        <div
            class="rounded-lg border border-blue-200 bg-gradient-to-br from-blue-50 to-white p-4 dark:border-blue-900 dark:from-blue-900/20 dark:to-slate-800">
            <div class="mb-2 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
                Longest Streak
            </div>
            <div class="text-3xl font-bold text-slate-900 dark:text-slate-100">@Stats.LongestStreak</div>
            <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">Personal best</div>
        </div>

        <!-- Total Entries -->
        <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-2 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Total Entries
            </div>
            <div class="text-3xl font-bold text-slate-900 dark:text-slate-100">@Stats.TotalEntries</div>
            <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">@GetRangeLabel()</div>
        </div>

        <!-- Average Words -->
        <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-2 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                Avg. Words
            </div>
            <div class="text-3xl font-bold text-slate-900 dark:text-slate-100">@Stats.AverageWordCount</div>
            <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">Per entry</div>
        </div>
    </div>

    <!-- Most Frequent Mood -->
    @if (Stats.MostFrequentMood != null)
    {
        <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
            <h3 class="mb-3 text-sm font-medium text-slate-500 dark:text-slate-400">Most Frequent Mood</h3>
            <div class="flex items-center gap-3">
                <span class="text-4xl">@Stats.MostFrequentMood.Emoji</span>
                <div>
                    <p class="text-xl font-semibold text-slate-900 dark:text-slate-100">@Stats.MostFrequentMood.Name</p>
                    <p class="text-sm capitalize text-slate-500 dark:text-slate-400">@Stats.MostFrequentMood.Category</p>
                </div>
            </div>
        </div>
    }

    <!-- Mood Distribution & Top Tags -->
    <div class="grid gap-4 md:grid-cols-2">
        <!-- Mood Distribution -->
        <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
            <h3 class="mb-4 flex items-center gap-2 text-sm font-medium text-slate-500 dark:text-slate-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
                </svg>
                Mood Distribution
            </h3>

            @if (Stats.TotalMoodEntries > 0)
            {
                <div class="space-y-3">
                    <!-- Positive -->
                    <div>
                        <div class="mb-1 flex items-center justify-between text-sm">
                            <span class="font-medium text-slate-700 dark:text-slate-300">Positive</span>
                            <span
                                class="text-slate-500 dark:text-slate-400">@GetPercentage(Stats.MoodDistribution.Positive)%</span>
                        </div>
                        <div class="h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                            <div class="h-full bg-green-500"
                                style="width: @GetPercentage(Stats.MoodDistribution.Positive)%"></div>
                        </div>
                    </div>

                    <!-- Neutral -->
                    <div>
                        <div class="mb-1 flex items-center justify-between text-sm">
                            <span class="font-medium text-slate-700 dark:text-slate-300">Neutral</span>
                            <span
                                class="text-slate-500 dark:text-slate-400">@GetPercentage(Stats.MoodDistribution.Neutral)%</span>
                        </div>
                        <div class="h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                            <div class="h-full bg-blue-500" style="width: @GetPercentage(Stats.MoodDistribution.Neutral)%">
                            </div>
                        </div>
                    </div>

                    <!-- Negative -->
                    <div>
                        <div class="mb-1 flex items-center justify-between text-sm">
                            <span class="font-medium text-slate-700 dark:text-slate-300">Negative</span>
                            <span
                                class="text-slate-500 dark:text-slate-400">@GetPercentage(Stats.MoodDistribution.Negative)%</span>
                        </div>
                        <div class="h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                            <div class="h-full bg-red-500" style="width: @GetPercentage(Stats.MoodDistribution.Negative)%">
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="flex h-32 items-center justify-center text-slate-400 dark:text-slate-500">
                    No entries yet
                </div>
            }
        </div>

        <!-- Top Tags -->
        <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
            <h3 class="mb-4 flex items-center gap-2 text-sm font-medium text-slate-500 dark:text-slate-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
                Most Used Tags
            </h3>

            @if (Stats.TopTags.Any())
            {
                <div class="space-y-2">
                    @foreach (var tag in Stats.TopTags)
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-slate-700 dark:text-slate-300">@tag.Tag</span>
                            <div class="flex items-center gap-2">
                                <div class="h-1.5 w-24 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                                    <div class="h-full bg-blue-600 dark:bg-blue-500"
                                        style="width: @GetTagPercentage(tag.Count)%"></div>
                                </div>
                                <span class="w-6 text-right text-xs text-slate-500 dark:text-slate-400">@tag.Count</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex h-32 items-center justify-center text-slate-400 dark:text-slate-500">
                    No tags used yet
                </div>
            }
        </div>
    </div>

    <!-- Missed Days -->
    @if (Stats.MissedDays.Any() && SelectedRange != "all")
    {
        <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
            <h3 class="mb-3 flex items-center gap-2 text-sm font-medium text-slate-500 dark:text-slate-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Missed Days (@Stats.MissedDays.Count)
            </h3>
            <div class="flex flex-wrap gap-2">
                @foreach (var date in Stats.MissedDays.Take(14))
                {
                    <span
                        class="rounded-md bg-slate-100 px-2 py-1 text-xs text-slate-600 dark:bg-slate-700 dark:text-slate-300">
                        @date.ToString("MMM d")
                    </span>
                }
                @if (Stats.MissedDays.Count > 14)
                {
                    <span class="px-2 py-1 text-xs text-slate-400 dark:text-slate-500">
                        +@(Stats.MissedDays.Count - 14) more
                    </span>
                }
            </div>
        </div>
    }
</section>