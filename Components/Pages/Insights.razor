@page "/insights"
@using journalstart.Models
@using journalstart.Components.Shared

<!-- PIN Verification Modal for Export -->
@if (ShowPinModalForExport)
{
    <div style="
                position: fixed; 
                inset: 0; z-index: 9999; 
                display: flex; 
                align-items: center; 
                justify-content: center; 
                background-color: rgba(0, 0, 0, 0.5); 
                backdrop-filter: blur(15px);">
        <div style="margin: 0 1rem; width: 100%; max-width: 28rem;"
            class="rounded-lg border border-slate-200 bg-white p-6 shadow-xl dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-4 flex items-center gap-3">
                <div class="rounded-full bg-amber-100 p-3 dark:bg-amber-900/30">
                    <svg class="h-6 w-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Locked Entries Selected</h3>
                    <p class="text-sm text-slate-600 dark:text-slate-300">Enter your PIN to export locked journal entries
                    </p>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-300">Enter PIN</label>
                    <input type="password" @bind="ExportPin" @bind:event="oninput"
                        @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") _ = VerifyPinAndExport(); })"
                        maxlength="4" placeholder="4-digit PIN" autofocus
                        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-center text-lg tracking-widest text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" />
                </div>

                @if (!string.IsNullOrEmpty(PinErrorMessage))
                {
                    <div class="rounded-lg bg-red-50 p-3 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200">
                        <div class="flex items-center gap-2">
                            <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            <span>@PinErrorMessage</span>
                        </div>
                    </div>
                }

                <div class="flex gap-3">
                    <button @onclick="VerifyPinAndExport"
                        class="flex-1 rounded-lg bg-indigo-600 px-4 py-3 font-medium text-white transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:bg-indigo-500 dark:hover:bg-indigo-600">
                        Unlock & Export
                    </button>
                    <button @onclick="CancelPinForExport"
                        class="flex-1 rounded-lg border border-slate-300 bg-white px-4 py-3 font-medium text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<section class="mt-4 space-y-4">
    <!-- Export Action Bar (when in selection mode) -->
    @if (IsSelectionMode)
    {
        <div class="rounded-lg border-2 border-blue-500 bg-blue-50 p-4 dark:border-blue-400 dark:bg-blue-900/20">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <svg class="h-6 w-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <div>
                        <h3 class="font-semibold text-blue-900 dark:text-blue-100">Selection Mode</h3>
                        <p class="text-sm text-blue-700 dark:text-blue-300">
                            @SelectedEntryIds.Count selected • Click entries to select/deselect
                        </p>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button @onclick="SelectAllEntries"
                        class="rounded border border-blue-300 bg-white px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 dark:border-blue-600 dark:bg-blue-800 dark:text-blue-200 dark:hover:bg-blue-700">
                        Select All
                    </button>
                    <button @onclick="DeselectAllEntries" disabled="@(!SelectedEntryIds.Any())"
                        class="rounded border border-blue-300 bg-white px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 disabled:opacity-50 dark:border-blue-600 dark:bg-blue-800 dark:text-blue-200 dark:hover:bg-blue-700">
                        Clear
                    </button>
                    <button @onclick="ExportSelectedToPdf" disabled="@(!SelectedEntryIds.Any() || IsExporting)"
                        class="flex items-center gap-2 rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 disabled:opacity-50 dark:bg-blue-500 dark:hover:bg-blue-600">
                        @if (IsExporting)
                        {
                            <span>Exporting...</span>
                        }
                        else
                        {
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            <span>Export PDF</span>
                        }
                    </button>
                    <button @onclick="ToggleSelectionMode"
                        class="rounded border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600">
                        Cancel
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(ExportMessage))
            {
                <div
                    class="mt-3 rounded bg-white p-3 text-sm dark:bg-slate-800 @(ExportMessage.StartsWith("✓") ? "text-green-700 dark:text-green-400" : "text-red-700 dark:text-red-400")">
                    @ExportMessage
                </div>
            }
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
        <div class="flex gap-2">
            <!-- Search Input -->
            <div class="flex-1">
                <input type="text" @bind="SearchQuery" @bind:event="oninput"
                    class="w-full rounded border border-slate-300 py-2 px-3 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 dark:placeholder-slate-400"
                    placeholder="Search entries..." />
            </div>

            <!-- Export Button -->
            @if (!IsSelectionMode)
            {
                <button @onclick="ToggleSelectionMode"
                    class="flex items-center gap-2 rounded border border-green-500 bg-green-50 px-4 py-2 text-sm font-medium text-green-700 hover:bg-green-100 dark:border-green-600 dark:bg-green-900/20 dark:text-green-400 dark:hover:bg-green-900/30">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    Export PDF
                </button>
            }

            <!-- Filter Button -->
            <button @onclick="ToggleFilters"
                class="flex items-center gap-2 rounded border px-4 py-2 text-sm @(ShowFilters ? "border-blue-500 bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-400" : "border-slate-300 bg-white hover:bg-slate-50 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600")">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                </svg>
                Filters
                @if (ActiveFilterCount > 0)
                {
                    <span
                        class="flex h-5 w-5 items-center justify-center rounded-full bg-blue-600 text-xs text-white dark:bg-blue-500">@ActiveFilterCount</span>
                }
            </button>
        </div>

        <!-- Filters Panel -->
        @if (ShowFilters)
        {
            <div class="mt-4 space-y-4 border-t border-slate-200 pt-4 dark:border-slate-700">
                <div class="flex items-center justify-between">
                    <h4 class="font-medium text-slate-700 dark:text-slate-300">Filters</h4>
                    @if (ActiveFilterCount > 0)
                    {
                        <button @onclick="ClearAllFilters" class="text-xs text-red-600 hover:underline dark:text-red-400">
                            Clear all
                        </button>
                    }
                </div>

                <!-- Date Range -->
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-600 dark:text-slate-300">Date Range</label>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="date" value="@StartDate"
                            @onchange="@((ChangeEventArgs e) => { StartDate = e.Value?.ToString(); })"
                            class="rounded border border-slate-300 px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" />
                        <input type="date" value="@EndDate"
                            @onchange="@((ChangeEventArgs e) => { EndDate = e.Value?.ToString(); })"
                            class="rounded border border-slate-300 px-3 py-2 text-sm focus:border-blue-400 focus:outline-none dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100" />
                    </div>
                </div>

                <!-- Moods Filter -->
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-600 dark:text-slate-300">Moods</label>
                    <div class="space-y-2">
                        @foreach (var category in Enum.GetValues<MoodCategory>())
                        {
                            var categoryMoods = MoodCatalog.All.Where(m => m.Category == category).ToList();
                            if (categoryMoods.Any())
                            {
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var mood in categoryMoods)
                                    {
                                        var isSelected = SelectedMoods.Contains(mood.Id);
                                        <button @onclick="() => ToggleMood(mood.Id)"
                                            class="rounded-full px-3 py-1 text-xs transition @GetMoodFilterClass(mood.Category, isSelected)">
                                            @mood.Emoji @mood.Name
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Tags Filter -->
                <div>
                    <label class="mb-2 block text-sm font-medium text-slate-600 dark:text-slate-300">Tags</label>
                    <div class="flex flex-wrap gap-1">
                        @foreach (var tag in AllTags.Take(16))
                        {
                            var isSelected = SelectedTags.Contains(tag);
                            <button @onclick="() => ToggleTag(tag)"
                                class="rounded-full px-3 py-1 text-xs @(isSelected ? "bg-blue-600 text-white dark:bg-blue-500" : "bg-slate-100 text-slate-600 hover:bg-slate-200 dark:bg-slate-700 dark:text-slate-300 dark:hover:bg-slate-600")">
                                @tag
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Entry List -->
    <div class="space-y-3">
        @if (!FilteredEntries.Any())
        {
            <div
                class="rounded-lg border border-slate-200 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-800">
                <p class="text-slate-500 dark:text-slate-400">No entries found</p>
                <p class="mt-1 text-sm text-slate-400 dark:text-slate-500">Try adjusting your search or filters</p>
            </div>
        }
        else
        {
            @foreach (var entry in PaginatedEntries)
            {
                var isSelected = IsSelectionMode ? SelectedEntryIds.Contains(entry.Id) : SelectedEntryId == entry.Id;
                var borderClass = isSelected
                ? "ring-2 ring-blue-500 border-blue-500 dark:ring-blue-400 dark:border-blue-400"
                                        : "border-slate-200 dark:border-slate-700";

                <button @onclick="() => SelectEntry(entry)"
                    class="w-full rounded-lg border bg-white p-4 text-left transition hover:shadow-md dark:bg-slate-800 dark:hover:shadow-xl @borderClass">
                    <div class="flex items-start gap-4">
                        <!-- Selection Checkbox (in selection mode) -->
                        @if (IsSelectionMode)
                        {
                            <div class="shrink-0 pt-1">
                                <div
                                    class="flex h-5 w-5 items-center justify-center rounded border-2 @(isSelected ? "border-blue-500 bg-blue-500 dark:border-blue-400 dark:bg-blue-400" : "border-slate-300 dark:border-slate-600")">
                                    @if (isSelected)
                                    {
                                        <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                        </svg>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Date -->
                        <div class="shrink-0 text-center">
                            <p class="text-2xl font-semibold dark:text-slate-100">@entry.DateOnly.Day</p>
                            <p class="text-xs uppercase text-slate-400 dark:text-slate-500">@entry.DateOnly.ToString("MMM")</p>
                        </div>

                        <!-- Content -->
                        <div class="min-w-0 flex-1">
                            <div class="mb-1 flex items-center gap-2">
                                @if (entry.IsLocked)
                                {
                                    <!-- Locked Entry Indicator -->
                                    <svg class="h-5 w-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                    <span class="text-sm font-medium text-amber-700 dark:text-amber-400">Locked Entry</span>
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(entry.PrimaryMood))
                                    {
                                        var mood = MoodCatalog.Get(entry.PrimaryMood);
                                        if (mood != null)
                                        {
                                            <span class="text-lg">@mood.Emoji</span>
                                            <span class="text-sm font-medium dark:text-slate-200">@mood.Name</span>
                                        }
                                    }
                                    @if (entry.SecondaryMoods.Any())
                                    {
                                        <span class="text-slate-400 dark:text-slate-500">
                                            +@string.Join("", entry.SecondaryMoods.Select(id => MoodCatalog.Get(id)?.Emoji ?? ""))
                                        </span>
                                    }
                                }
                            </div>

                            @if (entry.IsLocked)
                            {
                                <!-- Locked Content Placeholder -->
                                <p class="text-sm italic text-slate-400 dark:text-slate-500">This entry is locked. Enter PIN to view
                                    content.</p>
                            }
                            else
                            {
                                <!-- Normal Content Display -->
                                <p class="line-clamp-2 text-sm text-slate-500 dark:text-slate-400">@StripHtml(entry.Content)</p>
                            }

                            @if (entry.Tags.Any() && !entry.IsLocked)
                            {
                                <div class="mt-2 flex flex-wrap gap-1">
                                    @foreach (var tag in entry.Tags.Take(3))
                                    {
                                        <span
                                            class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-700 dark:text-slate-300">@tag</span>
                                    }
                                    @if (entry.Tags.Count > 3)
                                    {
                                        <span class="text-xs text-slate-400 dark:text-slate-500">+@(entry.Tags.Count - 3)</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Word count -->
                        <div class="text-right">
                            @if (entry.IsLocked)
                            {
                                <div class="flex items-center gap-1 text-xs text-amber-600 dark:text-amber-400">
                                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                    <span>Locked</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400 dark:text-slate-500">@GetWordCount(entry.Content) words</span>
                            }
                        </div>
                    </div>
                </button>
            }

            <!-- Pagination -->
            @if (TotalPages > 1)
            {
                <div
                    class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-800">
                    <p class="text-sm text-slate-600 dark:text-slate-300">
                        Showing @((CurrentPage - 1) * PageSize + 1) to @Math.Min(CurrentPage * PageSize, FilteredEntries.Count)
                        of @FilteredEntries.Count entries
                    </p>
                    <div class="flex gap-1">
                        <button @onclick="PreviousPage" disabled="@(CurrentPage == 1)"
                            class="rounded border border-slate-300 px-3 py-1 text-sm disabled:opacity-50 disabled:cursor-not-allowed hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700">
                            Previous
                        </button>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNum = i;
                            <button @onclick="() => GoToPage(pageNum)"
                                class="rounded px-3 py-1 text-sm @(CurrentPage == pageNum ? "bg-blue-600 text-white dark:bg-blue-500" : "border border-slate-300 hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700")">
                                @pageNum
                            </button>
                        }
                        <button @onclick="NextPage" disabled="@(CurrentPage == TotalPages)"
                            class="rounded border border-slate-300 px-3 py-1 text-sm disabled:opacity-50 disabled:cursor-not-allowed hover:bg-slate-50 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-700">
                            Next
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</section>