@page "/timeline"
@using journalstart.Models

<section class="mt-4 space-y-4">
    <div class="grid gap-4 lg:grid-cols-[380px_1fr]">
        <!-- Calendar Panel -->
        <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100">@CurrentMonth.ToString("MMMM yyyy")
                </h2>
                <div class="flex gap-1">
                    <button
                        class="rounded border border-slate-300 p-1 hover:bg-slate-50 dark:border-slate-600 dark:hover:bg-slate-700"
                        @onclick="PreviousMonth">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                        </svg>
                    </button>
                    <button
                        class="rounded border border-slate-300 p-1 hover:bg-slate-50 dark:border-slate-600 dark:hover:bg-slate-700"
                        @onclick="NextMonth">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Calendar Grid -->
            <div class="space-y-2">
                <!-- Day Headers -->
                <div class="grid grid-cols-7 gap-1 text-center">
                    @foreach (var day in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                    {
                        <div class="text-xs font-medium text-slate-500 dark:text-slate-400">@day</div>
                    }
                </div>

                <!-- Calendar Days -->
                <div class="grid grid-cols-7 gap-1">
                    @foreach (var day in CalendarDays)
                    {
                        <button @onclick="() => SelectDate(day.Date)"
                            class="relative aspect-square rounded-md p-1 text-sm transition @GetDayClasses(day)"
                            disabled="@(!day.IsCurrentMonth)">
                            <span class="relative z-10">@day.Date.Day</span>
                            @if (day.HasEntry)
                            {
                                <span
                                    class="absolute bottom-1 left-1/2 h-1 w-1 -translate-x-1/2 rounded-full bg-pink-500"></span>
                            }
                        </button>
                    }
                </div>
            </div>

            <!-- Legend -->
            <div class="mt-4 space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
                <div class="flex items-center gap-1">
                    <div class="h-3 w-3 rounded-full border-2 border-slate-800 dark:border-slate-200"></div>
                    <span>Selected</span>
                </div>
                <div class="flex items-center gap-1">
                    <div class="h-3 w-3 rounded-md bg-slate-200 dark:bg-slate-700"></div>
                    <span>Today</span>
                </div>
                <div class="flex items-center gap-1">
                    <div class="h-1 w-1 rounded-full bg-pink-500"></div>
                    <span>Has entry</span>
                </div>
            </div>
        </div>

        <!-- Entry Preview Panel -->
        <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
            <h3 class="text-xl font-semibold text-slate-800 dark:text-slate-100">@SelectedDate.ToString("MMMM dd, yyyy")
            </h3>

            @if (SelectedEntry != null)
            {
                @if (SelectedEntry.IsLocked)
                {
                    <!-- Locked Entry View -->
                    <div class="mt-8 space-y-4 text-center">
                        <div
                            class="mx-auto inline-flex items-center gap-3 rounded-lg bg-amber-50 px-6 py-4 dark:bg-amber-900/20"
                             @onclick="NavigateToEdit">
                            <svg class="h-8 w-8 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                            <div class="text-left">
                                <p class="font-semibold text-amber-900 dark:text-amber-200">Entry Locked</p>
                                <p class="text-sm text-amber-700 dark:text-amber-300">This entry is protected with a PIN</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Unlocked Entry View -->
                    <div class="mt-4 space-y-3">
                        <div class="prose prose-sm max-w-none">
                            @((MarkupString)(SelectedEntry.Content))
                        </div>

                        @if (!string.IsNullOrEmpty(SelectedEntry.PrimaryMood))
                        {
                            var mood = MoodCatalog.Get(SelectedEntry.PrimaryMood);
                            <div class="flex items-center gap-2 text-sm">
                                <span class="text-slate-500 dark:text-slate-400">Mood:</span>
                                @if (mood != null)
                                {
                                    <span>@mood.Emoji @mood.Name</span>
                                }
                            </div>
                        }

                        @if (SelectedEntry.Tags.Any())
                        {
                            <div class="flex flex-wrap gap-1">
                                @foreach (var tag in SelectedEntry.Tags)
                                {
                                    <span
                                        class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-600 dark:bg-slate-700 dark:text-slate-300">@tag</span>
                                }
                            </div>
                        }

                        <button
                            class="rounded bg-blue-500 px-4 py-2 text-sm text-white hover:bg-blue-600 dark:bg-blue-600 dark:hover:bg-blue-700"
                            @onclick="NavigateToEdit">
                            Edit entry
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="mt-8 text-center">
                    <p class="text-slate-500 dark:text-slate-400">No entry for this day</p>
                    <button class="mt-4 text-sm text-blue-600 hover:underline dark:text-blue-400" @onclick="NavigateToEdit">
                        Write an entry →
                    </button>
                </div>
            }
        </div>
    </div>
</section>