@page "/"
@using System.Text.RegularExpressions
@using journalstart.Models
@inject JournalService JournalService

<section class="mt-4 space-y-4 rounded-lg border border-slate-200 bg-white p-4">
    <div class="flex flex-col gap-3">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex items-center gap-3">
                <div class="text-2xl">📔</div>
                <div>
                    <h1 class="text-xl font-bold text-slate-800">@SelectedDate.ToString("dddd")</h1>
                    <div class="flex items-center gap-2 text-sm text-slate-500">
                        <span>@SelectedDate.ToString("MMMM dd, yyyy")</span>
                        @if (IsToday)
                        {
                            <span class="rounded bg-green-100 px-2 py-0.5 text-xs text-green-700">Today</span>
                        }
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <button class="rounded border border-slate-300 bg-slate-50 px-3 py-1 text-sm hover:bg-slate-100"
                    @onclick="() => ChangeDay(-1)" disabled="@_isBusy">← Prev</button>
                <span class="px-2 text-sm font-medium">@SelectedDate.ToString("MMM dd")</span>
                <button class="rounded border border-slate-300 bg-slate-50 px-3 py-1 text-sm hover:bg-slate-100"
                    @onclick="() => ChangeDay(1)" disabled="@_isBusy">Next →</button>
            </div>
        </div>

        @if (HasEntry)
        {
            <p class="text-xs text-slate-400">
                Created: @CreatedAtUtc?.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                @if (UpdatedAtUtc.HasValue && UpdatedAtUtc != CreatedAtUtc)
                {
                    <span> • Updated: @UpdatedAtUtc?.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</span>
                }
            </p>
        }
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
        <div class="lg:col-span-2 space-y-3 rounded-lg border border-slate-200 bg-white p-4">
            <div class="flex items-center justify-between">
                <h2 class="font-semibold text-slate-700">Write your thoughts</h2>
                <span class="text-xs text-slate-400">@WordCount words</span>
            </div>
            <MarkdownEditor @bind-Value="Content" Disabled="@_isBusy" />
        </div>

        <div class="space-y-4 rounded-lg border border-slate-200 bg-white p-4">
            <div>
                <label class="text-sm font-medium text-slate-600">How are you feeling?</label>
                <div class="mt-2 grid grid-cols-2 gap-2">
                    @foreach (var mood in MoodOptions)
                    {
                        var isActive = PrimaryMood == mood.Id;
                        <button class="rounded border px-2 py-1 text-sm @GetMoodClasses(isActive)"
                            @onclick="() => SetPrimaryMood(mood.Id)">
                            @mood.Emoji @mood.Label
                        </button>
                    }
                </div>
            </div>

            <div>
                <label class="text-sm font-medium text-slate-600">Also feeling... (optional)</label>
                <div class="mt-2 grid grid-cols-2 gap-2">
                    @foreach (var mood in MoodOptions)
                    {
                        var isActive = SecondaryMoods.Contains(mood.Id);
                        <button class="rounded border px-2 py-1 text-sm @GetMoodClasses(isActive)"
                            @onclick="() => ToggleSecondaryMood(mood.Id)">
                            @mood.Emoji @mood.Label
                        </button>
                    }
                </div>
            </div>

            <div>
                <label class="text-sm font-medium text-slate-600">Tags</label>
                <div class="mt-2 flex gap-2">
                    <input class="flex-1 rounded border border-slate-300 px-2 py-1 text-sm focus:border-blue-400 focus:outline-none"
                        placeholder="Add a tag..." @bind="NewTag" @bind:event="oninput" @onkeydown="OnTagKeyDown" />
                    <button class="rounded bg-blue-500 px-3 py-1 text-sm text-white hover:bg-blue-600 disabled:bg-blue-300"
                        @onclick="AddTag" disabled="@string.IsNullOrWhiteSpace(NewTag)">Add</button>
                </div>
                <div class="mt-2 flex flex-wrap gap-1">
                    @if (!Tags.Any())
                    {
                        <span class="text-xs text-slate-400">No tags yet</span>
                    }
                    @foreach (var tag in Tags)
                    {
                        <span class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-600">
                            @tag
                            <button class="ml-1 text-slate-400 hover:text-slate-600" @onclick="() => RemoveTag(tag)">×</button>
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="flex gap-2">
        <button class="rounded bg-blue-500 px-4 py-2 text-sm text-white hover:bg-blue-600 disabled:bg-blue-300"
            @onclick="SaveAsync" disabled="@(_isBusy || !CanSave)">
            @(HasEntry ? "Update" : "Save")
        </button>
        @if (HasEntry)
        {
            <button class="rounded border border-red-300 px-4 py-2 text-sm text-red-600 hover:bg-red-50"
                @onclick="DeleteAsync" disabled="@_isBusy">
                Delete
            </button>
        }
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <span class="text-sm text-slate-500">@StatusMessage</span>
        }
    </div>
</section>

@code {
    private DateOnly SelectedDate = DateOnly.FromDateTime(DateTime.Now);
    private string Content = string.Empty;
    private string? PrimaryMood;
    private List<string> SecondaryMoods = new();
    private List<string> Tags = new();
    private string NewTag = string.Empty;
    private DateTime? CreatedAtUtc;
    private DateTime? UpdatedAtUtc;
    private bool HasEntry;
    private bool _isBusy;
    private string StatusMessage = string.Empty;
    private JournalEntry? _loaded;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntryAsync();
    }

    private async Task LoadEntryAsync()
    {
        _isBusy = true;
        StatusMessage = string.Empty;
        var entry = await JournalService.GetEntryAsync(SelectedDate);

        if (entry is not null)
        {
            _loaded = entry;
            Content = entry.Content;
            PrimaryMood = entry.PrimaryMood;
            SecondaryMoods = entry.SecondaryMoods.ToList();
            Tags = entry.Tags.ToList();
            CreatedAtUtc = entry.CreatedAt;
            UpdatedAtUtc = entry.UpdatedAt;
            HasEntry = true;
        }
        else
        {
            _loaded = null;
            Content = string.Empty;
            PrimaryMood = null;
            SecondaryMoods = new();
            Tags = new();
            CreatedAtUtc = null;
            UpdatedAtUtc = null;
            HasEntry = false;
        }

        _isBusy = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Content) || string.IsNullOrWhiteSpace(PrimaryMood))
        {
            StatusMessage = "Add text and select a primary mood before saving.";
            return;
        }

        _isBusy = true;
        StatusMessage = string.Empty;

        var saved = await JournalService.UpsertEntryAsync(SelectedDate, Content.Trim(), PrimaryMood, SecondaryMoods.ToList(),
        Tags.ToList());
        _loaded = saved;
        Content = saved.Content;
        PrimaryMood = saved.PrimaryMood;
        SecondaryMoods = saved.SecondaryMoods.ToList();
        Tags = saved.Tags.ToList();
        CreatedAtUtc = saved.CreatedAt;
        UpdatedAtUtc = saved.UpdatedAt;
        HasEntry = true;
        StatusMessage = "Entry saved.";
        _isBusy = false;
    }

    private async Task DeleteAsync()
    {
        _isBusy = true;
        StatusMessage = string.Empty;

        var removed = await JournalService.DeleteEntryAsync(SelectedDate);
        if (removed)
        {
            Content = string.Empty;
            PrimaryMood = null;
            SecondaryMoods = new();
            Tags = new();
            CreatedAtUtc = null;
            UpdatedAtUtc = null;
            HasEntry = false;
            StatusMessage = "Entry deleted.";
        }
        else
        {
            StatusMessage = "No entry to delete for this date.";
        }

        _isBusy = false;
    }

    private async Task ChangeDay(int deltaDays)
    {
        SelectedDate = SelectedDate.AddDays(deltaDays);
        await LoadEntryAsync();
    }

    private int WordCount
    {
        get
        {
            var text = Regex.Replace(Content ?? string.Empty, "<[^>]+>", " ");
            return text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
        }
    }

    private bool IsToday => SelectedDate == DateOnly.FromDateTime(DateTime.Now);

    private bool CanSave => !string.IsNullOrWhiteSpace(Content) && !string.IsNullOrWhiteSpace(PrimaryMood) && HasChanges;

    private bool HasChanges
    {
        get
        {
            if (_loaded is null)
            {
                return !string.IsNullOrWhiteSpace(Content) || !string.IsNullOrWhiteSpace(PrimaryMood) || SecondaryMoods.Any() ||
                Tags.Any();
            }

            var contentChanged = !string.Equals(Content, _loaded.Content, StringComparison.Ordinal);
            var primaryChanged = !string.Equals(PrimaryMood, _loaded.PrimaryMood, StringComparison.Ordinal);
            var secondaryChanged = !SecondaryMoods.SequenceEqual(_loaded.SecondaryMoods);
            var tagsChanged = !Tags.SequenceEqual(_loaded.Tags);
            return contentChanged || primaryChanged || secondaryChanged || tagsChanged;
        }
    }

    private void SetPrimaryMood(string id)
    {
        PrimaryMood = id;
    }

    private void ToggleSecondaryMood(string id)
    {
        if (SecondaryMoods.Contains(id))
        {
            SecondaryMoods.Remove(id);
        }
        else
        {
            SecondaryMoods.Add(id);
        }
    }

    private void AddTag()
    {
        var trimmed = (NewTag ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return;
        }

        if (!Tags.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
        {
            Tags.Add(trimmed);
        }

        NewTag = string.Empty;
    }

    private void RemoveTag(string tag)
    {
        Tags.Remove(tag);
    }

    private void OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTag();
        }
    }

    private string GetMoodClasses(bool active) => active
    ? "border-emerald-300 bg-emerald-50 text-emerald-700"
    : "border-slate-200 bg-white text-slate-700";

    private record MoodOption(string Id, string Label, string Emoji);

    private List<MoodOption> MoodOptions { get; } = new()
{
new MoodOption("calm", "Calm", "😌"),
new MoodOption("happy", "Happy", "😊"),
new MoodOption("excited", "Excited", "🤩"),
new MoodOption("focused", "Focused", "🎯"),
new MoodOption("tired", "Tired", "😴"),
new MoodOption("anxious", "Anxious", "😬"),
new MoodOption("sad", "Sad", "😔"),
new MoodOption("grateful", "Grateful", "🙏"),
};
}